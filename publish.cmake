# Release boundary: copy the linked EXE, verify SHA256 and preserve existing user configuration.
get_filename_component(DEST_DIR "${DEST}" DIRECTORY)
file(MAKE_DIRECTORY "${DEST_DIR}")
file(COPY_FILE "${SOURCE}" "${DEST}" ONLY_IF_DIFFERENT)
file(SHA256 "${SOURCE}" BUILD_HASH)
file(SHA256 "${DEST}" DIST_HASH)
if(NOT BUILD_HASH STREQUAL DIST_HASH)
  message(FATAL_ERROR "Published EXE hash mismatch: ${DEST}")
endif()
file(COPY_FILE "${ROOT}/README.md" "${DEST_DIR}/README.md" ONLY_IF_DIFFERENT)
if(NOT EXISTS "${DEST_DIR}/config.toml")
  file(COPY_FILE "${ROOT}/config.example.toml" "${DEST_DIR}/config.toml")
endif()
message(STATUS "Published and verified: ${DEST}")
